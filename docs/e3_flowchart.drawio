        <mxCell id="es_trip_act" value="Eksekusi Trip" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=10;fontColor=#334155;strokeColor=#e11d48;strokeWidth=2;" edge="1" parent="1" source="s8_trip" target="a2">
