        <mxCell id="es_7b_norm" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=10;fontColor=#334155;strokeColor=#059669;" edge="1" parent="1" source="s7b" target="s8_norm">
          <mxGeometry relative="1" as="geometry"/>
