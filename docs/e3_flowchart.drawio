        <mxCell id="es_7_notrip" value="Tidak" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;fontSize=10;fontColor=#334155;strokeColor=#059669;" edge="1" parent="1" source="s7" target="s7b">
