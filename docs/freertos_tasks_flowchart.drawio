etica;fontSize=9.5;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as_="points"><mxPoint x="670" y="397" /><mxPoint x="670" y="540" /></Array></mxGeometry></mxCell><mxCell id="eo11" parent="1" edge="1" source="t_oled" target="wdg" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=9.5;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" value="Kick Watchdog"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eo12" parent="1" edge="1" source="t_dlms" target="nvm_flash" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=9.5;fontColor=#000000;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" value="Simpan Snapshot Logbook"><mxGeometry relative="1" as="geometry"><Array as_="points"><mxPoint x="650" y="420" /><mxPoint x="650" y="640" /></Array></mxGeometry></mxCell><mxCell id="eo13" parent="1" edge="1" source="t_prof" target="nvm_flash" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;fontFamily=Helvetica;fontSize=9.5;fontColor=#000000;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" value="Bekukan Profil 15-M"><mxGeometry relative="1" as="geometry"><Array as_="points"><mxPoint x="640" y="300" /><mxPoint x="640" y="670" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="tab1_task_tamper" name="2. Task 1: TamperTask"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;FLOWCHART TASK 1: TAMPER EMERGENCY MONITOR (task_tamper_emergency_entry)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Siklus: 200 ms | Prioritas: High (3) | Pemantauan 9 Vektor Sabotase &amp; Pengamanan Relai Darurat&lt;/font&gt;"><mxGeometry x="50" y="20" width="700" height="46" as="geometry" /></mxCell><mxCell id="t1_start" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Helvetica;fontSize=11;fontColor=#000000;align=center;" value="&lt;b&gt;Mulai TamperTask&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;task_tamper_emergency_entry&lt;/font&gt;"><mxGeometry x="270" y="80" width="260" height="45" as="geometry" /></mxCell><mxCell id="t1_init" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#000000;align=center;" value="Inisialisasi status alarm:&lt;br/&gt;&lt;code&gt;last_alarm_state = false&lt;/code&gt;"><mxGeometry x="270" y="145" width="260" height="45" as="geometry" /></mxCell><mxCell id="t1_read" parent="1" vertex="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#000000;align=center;" value="Baca status alarm sabotase aktif:&lt;br/&gt;&lt;code&gt;current_alarm = display_task_is_alarm_active()&lt;/code&gt;"><mxGeometry x="270" y="210" width="260" height="50" as="geometry" /></mxCell><mxCell id="t1_dec_chg" parent="1" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#000000;align=center;spacing=2;" value="Apakah status alarm&lt;br/&gt;mengalami perubahan?&lt;br/&gt;&lt;code&gt;(current != last)&lt;/code&gt;"><mxGeometry x="270" y="280" width="260" height="70" as="geometry" /></mxCell><mxCell id="t1_dec_act" parent="1" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#000000;align=center;spacing=2;" value="Apakah status baru AKTIF?&lt;br/&gt;&lt;code&gt;(current_alarm == true)&lt;/code&gt;"><mxGeometry x="270" y="370" width="260" height="70" as="geometry" /></mxCell><mxCell id="t1_trip" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#000000;align=center;" value="&lt;b&gt;PUTUS RELAI SEKETIKA!&lt;/b&gt;&lt;br/&gt;&lt;code&gt;power_relay_disconnect(..., now_sec)&lt;/code&gt;&lt;br/&gt;Relai Masuk State DISCONNECTED"><mxGeometry x="130" y="465" width="250" height="55" as="geometry" /></mxCell><mxCell id="t1_normal" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#000000;align=center;" value="&lt;b&gt;Sabotase Dipulihkan&lt;/b&gt;&lt;br/&gt;Log: Sabotase dinormalkan,&lt;br/&gt;Sistem kembali ke kondisi normal"><mxGeometry x="420" y="465" width="250" height="55" as="geometry" /></mxCell><mxCell id="t1_update_state" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#000000;align=center;" value="Simpan riwayat status memori:&lt;br/&gt;&lt;code&gt;last_alarm_state = current_alarm&lt;/code&gt;&lt;br/&gt;Ambil waktu RTC: &lt;code&gt;now_sec&lt;/code&