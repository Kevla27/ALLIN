<mxfile host="Electron" modified="2026-11-17T09:10:00.000Z" agent="Mozilla/5.0 Antigravity Smart Meter Architect" version="24.7.17" type="device"><diagram id="tab0_rtos_overview" name="1. Arsitektur Task &amp; IPC"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;fontFamily=Helvetica;" value="&lt;b style=&quot;font-size: 14px;&quot;&gt;ARSITEKTUR MULTI-TASKING &amp; INTER-TASK COMMUNICATION (IPC) FREERTOS&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Integrasi Task Pilar E3, Komunikasi Queue xTamperQueue, Mutex xMeasMutex, dan Supervisi Watchdog&lt;/font&gt;"><mxGeometry x="50" y="20" width="1000" height="46" as="geometry" /></mxCell><mxCell id="hw_tamper" parent="1" vertex="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#000000;align=center;" value="&lt;b&gt;EXTI ISR SABOTASE FISIK&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;- Saklar Buka Tutup Meter (PC13)&lt;br/&gt;- Saklar Terminal Buka (PE6)&lt;br/&gt;- Sensor Magnetik Hall (PE4)&lt;/font&gt;"><mxGeometry x="50" y="120" width="240" height="75" as="geometry" /></mxCell><mxCell id="hw_ade" parent="1" vertex="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#000000;align=center;" value="&lt;b&gt;ADE9000 SPI1 / EXTI ISR&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;- ADE_IRQ0 Tamper Reverse (PB5)&lt;br/&gt;- ADE_IRQ1 Netral Bypass (PB1)&lt;br/&gt;- Data Ready Sinyal Sampling&lt;/font&gt;"><mxGeometry x="50" y="240" width="240" height="75" as="geometry" /></mxCell><mxCell id="hw_timer" parent="1" vertex="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#000000;align=center;" value="&lt;b&gt;SYSTEM TICK TIMER&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;- SysTick 1000 Hz (1 ms tick)&lt;br/&gt;- Hardware RTC Sub-detik (PD11)&lt;/font&gt;"><mxGeometry x="50" y="360" width="240" height="65" as="geometry" /></mxCell><mxCell id="t_tamper" parent="1" vertex="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#000000;align=center;" value="&lt;b&gt;Task 1: TamperTask&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;task_tamper_emergency_entry&lt;br/&gt;Prioritas: 3 (High) | Siklus: 200 ms&lt;br/&gt;Evaluasi 9 Tamper &amp;amp; Trip Relai&lt;/font&gt;"><mxGeometry x="370" y="120" width="260" height="75" as="geometry" /></mxCell><mxCell id="t_prof" parent="1" vertex="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#000000;align=center;" value="&lt;b&gt;Task 2: ProfileTask&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;task_metrology_profiling_entry&lt;br/&gt;Prioritas: 2 (Normal) | Siklus: 1000 ms&lt;br/&gt;Sampling, Asimetri &amp;amp; Profil 15-M&lt;/font&gt;"><mxGeometry x="370" y="240" width="260" height="75" as="geometry" /></mxCell><mxCell id="t_dlms" parent="1" vertex="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#000000;align=center;" value="&lt;b&gt;Task 3: DLMSTask&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;task_dlms_entry&lt;br/&gt;Prioritas: 2 (Normal) | Siklus: 10 ms&lt;br/&gt;Antrean Sabotase &amp;amp; Server HDLC&lt;/font&gt;"><mxGeometry x="370" y="360" width="260" height="75" as="geometry" /></mxCell><mxCell id="t_oled" parent="1" vertex="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#000000;align=center;" value="&lt;b&gt;Task 4: OLEDTask&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;task_oled128x32_carousel&lt;br/&gt;Prioritas: 1 (Low) | Siklus: 100 ms&lt;br/&gt;Carousel Layar SPLN SSD1306&lt;/font&gt;"><mxGeometry x="370" y="480" width="260" height="75" as="geometry" /></mxCell><mxCell id="t_bridge" parent="1" vertex="1" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#000000;align=center;" value="&lt;b&gt;Task 5: DefaultMeteringTask&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;app_metering_task_loop (CMSIS-RTOS2)&lt;br/&gt;Prioritas: Normal | Siklus: 100 ms&lt;br/&gt;Jembatan Tiga Pilar (E1, E2, E3)&lt;/font&gt;"><mxGeometry x="370" y="600" width="260" height="75" as="geometry" /></mxCell><mxCell id="ipc_q" parent="1" vertex="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#000000;align=center;" value="&lt;b&gt;QUEUE: xTamperQueue&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Kapasitas: 16 pesan event&lt;br/&gt;Struktur: tamper_event_msg_t&lt;br/&gt;Pengirim: ISR &amp;amp; TamperTask&lt;br/&gt;Penerima: DLMSTask&lt;/font&gt;"><mxGeometry x="720" y="200" width="260" height="80" as="geometry" /></mxCell><mxCell id="ipc_mtx" parent="1" vertex="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#000000;align=center;" value="&lt;b&gt;MUTEX: xMeasMutex&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Proteksi Snapshot Pengukuran:&lt;br/&gt;meter_measurements_t s_latest&lt;br/&gt;Penulis: ProfileTask&lt;br/&gt;Pembaca: OLEDTask &amp;amp; DLMS&lt;/font&gt;"><mxGeometry x="720" y="340" width="260" height="80" as="geometry" /></mxCell><mxCell id="wdg" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10.5;fontColor=#000000;align=center;" value="&lt;b&gt;WATCHDOG MONITOR (IWDG)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Bitmask: s_watchdog_kicked_mask&lt;br/&gt;Wajib ditendang oleh ke-4 task:&lt;br/&gt;Tamper(0x1), Metr(0x2), DLMS(0x4), UI(0x8)&lt;/font&gt;"><mxGeometry x="720" y="480" width="260" height="80" as="geometry" /></mxCell><mxCell id="nvm_flash" parent="1" vertex="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontFamily=Helvetica;fontSize=10;fontColor=#000000;align=center;" value="&lt;b&gt;PENYIMPANAN FLASH NVM&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;- D1: Last-Gasp Checkpoint (&amp;lt;15ms)&lt;br/&gt;- D2: 3 Register Logbook FIFO&lt;br/&gt;- D3: Profil Beban 15-M (60 Hari)&lt;br/&gt;- D4: Tabel Tarif ToU &amp;amp; Kontrak&lt;/font&gt;"><mxGeometry x="720" y="620" width="260" height="80" as="geometry" /></mxCell><mxCell id="eo1" parent="1" edge="1" source="hw_tamper" target="t_tamper" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#000000;strokeWidth=1.5;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;font