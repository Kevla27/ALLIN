  <diagram id="Tab6_Asynchronous_ISR" name="6. Jalur Asinkron &amp; ISR">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="880" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="isr_hdr" value="&lt;b&gt;FLOWCHART RINCI: JALUR ASINKRON &amp;amp; INTERRUPT SERVICE ROUTINE (ISR)&lt;/b&gt;&lt;br/&gt;Penanganan Paket Serial UART DLMS serta Kejadian Eksternal GPIO EXTI Hardware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="u_start" value="&lt;b&gt;HAL_UART_RxCpltCallback(huart)&lt;/b&gt;&lt;br/&gt;Interupsi Penerimaan Karakter Serial USART" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="85" width="340" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="u_push" value="&lt;b&gt;e2_dlms_service_uart_rx_callback()&lt;/b&gt;&lt;br/&gt;Push Karakter ke Dekoder Frame HDLC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="155" width="340" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="u_q_hdlc" value="&lt;b&gt;Frame HDLC Lengkap &amp;amp; Valid?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#eab308;fontColor=#713f12;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="130" y="225" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="u_parse" value="&lt;b&gt;Pembedah Layer Aplikasi APDU DLMS&lt;/b&gt;&lt;br/&gt;Identifikasi Tag Permintaan Masuk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="340" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="u_exec" value="&lt;b&gt;Eksekusi Perintah APDU DLMS&lt;/b&gt;&lt;br/&gt;Proses AARQ (0x60), GET (0xC0), SET (0xC1) atau Glo-Cipher AES-GCM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;fontColor=#064e3b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="370" width="340" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="u_tx" value="&lt;b&gt;Kirim Respons Frame HDLC via UART&lt;/b&gt;&lt;br/&gt;Transmisi Paket Balasan ke Port Optik / Modem" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="445" width="340" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="u_rearm" value="&lt;b&gt;Aktifkan Kembali Interupsi UART RX&lt;/b&gt;&lt;br/&gt;Siapkan Buffer untuk Byte Serial Berikutnya" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=#334155;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
