        </mxCell>
        <mxCell id="x_acfail" value="&lt;b&gt;AC_FAIL_DET (PC3 - Listrik Padam / Pulih)&lt;/b&gt;&lt;br/&gt;• Falling: Last-Gasp Notifikasi DLMS, Simpan Checkpoint &amp;amp; Masuk Stop 2&lt;br/&gt;• Rising: Pulihkan Sistem, Re-arm ADE9000 &amp;amp; Nyalakan OLED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="250" width="405" height="54" as="geometry" />
        </mxCell>
        <mxCell id="x_btn" value="&lt;b&gt;Tombol Navigasi Layar (PA0 UP / PB6 DN)&lt;/b&gt;&lt;br/&gt;• Satu Tombol: Navigasi Layar Manual / Bangunkan OLED Off-Power&lt;br/&gt;• Tekan Simultan (▲ + ▼) 1 Detik: Konfirmasi Rekoneksi Relai Manual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="325" width="405" height="54" as="geometry" />
        </mxCell>
        <mxCell id="x_ade" value="&lt;b&gt;ADE_IRQ / DREADY / CF (Data Ready &amp;amp; Pulsa)&lt;/b&gt;&lt;br/&gt;• PB5 IRQ0: Reverse Power | PB1 IRQ1: Netral Bypass | PE11: DREADY (Data Ready ADC)&lt;br/&gt;• PE12 CF1: Pulsa Aktif | PE13 CF2: Pulsa Reaktif | PE8: Zero Crossing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="400" width="405" height="54" as="geometry" />
        </mxCell>
        <mxCell id="x_aux" value="&lt;b&gt;AUX_CTRL_IN1 (PC10) &amp;amp; IN2 (PC14)&lt;/b&gt;&lt;br/&gt;Input Sinyal Bantu Eksternal &amp;amp; Pencatatan Logbook Status I/O" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="475" width="405" height="46" as="geometry" />
        </mxCell>
        <mxCell id="x_end" value="&lt;b&gt;Selesai Penanganan Event ISR GPIO&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=#334155;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="615" y="545" width="275" height="40" as="geometry" />
        </mxCell>
        <mxCell id="x_card" value="&lt;b&gt;MANAJEMEN OFF-POWER STANDBY (10 DETIK):&lt;/b&gt;&lt;br/&gt;Saat listrik jala-jala padam, menekan tombol navigasi akan menyalakan layar OLED selama 10 detik dari cadangan superkapasitor (PC2 VCAP) agar pembacaan stand energi dapat dilakukan." style="rounded=1;whiteSpace=wrap;html=1;fontSize=9.5;align=left;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#78350f;spacingLeft=10;" vertex="1" parent="1">
