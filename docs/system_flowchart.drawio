        <mxCell id="x_d1" value="&lt;b&gt;Pin == AC_FAIL?&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(PC3 Catu Daya Padam)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="168" width="190" height="48" as="geometry" />
        </mxCell>

        <mxCell id="x_act1" value="&lt;b&gt;Last-Gasp Padam / Pulih Listrik&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;• Falling: Simpan Checkpoint Flash &amp;amp; Masuk Stop 2&lt;br/&gt;• Rising: Bangunkan Sistem, Re-arm ADE &amp;amp; OLED&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="780" y="168" width="280" height="48" as="geometry" />
        </mxCell>

        
        <mxCell id="x_d2" value="&lt;b&gt;Pin == Tombol HMI?&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(PA0 Atas / PB6 Bawah)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="560" y="238" width="190" height="48" as="geometry" />
        </mxCell>

        <mxCell id="x_act2" value="&lt;b&gt;Navigasi HMI &amp;amp; Off-Power Standby&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;• Tekan Singkat: Ganti Layar Menu / Bangunkan OLED (10s)&lt;br/&gt;• Tekan Simultan (▲+▼): Konfirmasi Rekoneksi Relai&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="780" y="238" width="280" height="48" as="geometry" />
        </mxCell>

        
        <mxCell id="x_d3" value="&lt;b&gt;Pin == ADE9000 IRQ?&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(PE11 / PB5 / PB1 / PE8)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
