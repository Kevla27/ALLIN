        </mxCell>
        <mxCell id="x_end" value="&lt;b&gt;Selesai Penanganan Event ISR GPIO&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=#334155;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="530" y="475" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="x_card" value="&lt;b&gt;MANAJEMEN OFF-POWER STANDBY (10 DETIK):&lt;/b&gt;&lt;br/&gt;Saat listrik jala-jala padam, menekan tombol navigasi akan menyalakan layar OLED selama 10 detik dari cadangan superkapasitor agar pembacaan stand energi dapat dilakukan." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#78350f;" vertex="1" parent="1">
