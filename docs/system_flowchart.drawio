        </mxCell>
        <mxCell id="x_ade" value="&lt;b&gt;ADE_IRQ / EVENT / CF (Mutu Daya)&lt;/b&gt;&lt;br/&gt;Deteksi Reverse Power, Netral Hilang, Tegangan Dip/Swell serta Pulsa Kalibrasi Energi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=11;align=center;" vertex="1" parent="1">
