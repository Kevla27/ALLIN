        <mxCell id="x_act3" value="&lt;b&gt;Event Sensor Metrologi ADE9000&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;• PE11: Sinyal DREADY (ADC Siap Dibaca)&lt;br/&gt;• PB5: Reverse Power | PB1: Netral | PE8: Zero Crossing&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;align=left;spacingLeft=8;fontFamily=Helvetica;" vertex="1" parent="1">
