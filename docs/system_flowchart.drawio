        <mxCell id="x_title" value="&lt;b&gt;JALUR INTERRUPSI GPIO EXTI (HARDWARE EVENTS)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
