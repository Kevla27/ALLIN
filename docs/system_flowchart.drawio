        </mxCell>
        <mxCell id="x_acfail" value="&lt;b&gt;AC_FAIL_DET (Mati Listrik / Last-Gasp)&lt;/b&gt;&lt;br/&gt;Kirim Notifikasi DLMS 0xC2 via Superkapasitor, Simpan Checkpoint &amp;amp; Transisi ke Mode Stop 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#f43f5e;fontColor=#881337;fontSize=11;align=center;" vertex="1" parent="1">
