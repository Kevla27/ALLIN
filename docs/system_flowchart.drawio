  <diagram id="Tab7_Hardware_Layer" name="7. Hardware &amp; Pin Periferal">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="840" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="hw_hdr" value="&lt;b&gt;PETA LAPISAN PERANGKAT KERAS &amp;amp; ALOKASI PIN MCU (SPLN D3.006:2021)&lt;/b&gt;&lt;br/&gt;Antarmuka Periferal Fisik Berdasarkan Dokumen Resmi PIN.docx &amp;amp; Spesifikasi Hardware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="hw1" value="&lt;b&gt;AFE Metrologi ADE9000 (SPI1)&lt;/b&gt;&lt;br/&gt;Pin: PA4 (SS), PA5 (SCK), PA6 (MISO), PA7 (MOSI)&lt;br/&gt;Fungsi: Akuisisi 24-bit Arus &amp;amp; Tegangan 3-Fasa, THD, TDD &amp;amp; Zero-Crossing PE8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="85" width="310" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="hw2" value="&lt;b&gt;SPI2 Flash NVRAM W25Qxx (4 MB)&lt;/b&gt;&lt;br/&gt;Pin: PB12 (CS), PB13 (SCK), PB14 (MISO), PB15 (MOSI)&lt;br/&gt;Fungsi: Penyimpanan Load Profile, 3x FIFO Logbook &amp;amp; Checkpoint Energi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="430" y="85" width="310" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="hw3" value="&lt;b&gt;Layar OLED SSD1306 (I2C3)&lt;/b&gt;&lt;br/&gt;Pin: PC0 (SCL), PC1 (SDA), PD2 (Power Enable), PD3 (Backlight)&lt;br/&gt;Fungsi: Display Matriks Grafis 128x64 Standar SPLN Gambar 4 &amp;amp; 6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="185" width="310" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="hw4" value="&lt;b&gt;Relai Kontaktor &amp;amp; Driver Shunt Trip&lt;/b&gt;&lt;br/&gt;Pin: PC8 (RELAY_TRIP), PC9 (RELAY_CLOSE), PC7 (Status Umpan Balik)&lt;br/&gt;Fungsi: Pemutus Beban Arus Bolak-Balik &amp;amp; Proteksi Beban Lebih" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="430" y="185" width="310" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="hw5" value="&lt;b&gt;Port Komunikasi Serial Ganda&lt;/b&gt;&lt;br/&gt;Pin: USART3 PC4/PC5 (Port Optik 9600 bps), USART2 PA2/PA3 (Modem 19200 bps)&lt;br/&gt;Fungsi: Saluran Komunikasi Dua Arah Protokol DLMS/COSEM HDLC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="285" width="310" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="hw6" value="&lt;b&gt;Sensor Sabotase, Baterai &amp;amp; Superkapasitor&lt;/b&gt;&lt;br/&gt;Pin: PC13 (Tutup Meter), PE6 (Tutup Terminal), PE4 (Magnet), PD11 (VBAT), PC2 (VCAP)&lt;br/&gt;Fungsi: Deteksi Gangguan 24/7 &amp;amp; Telemetri Catu Cadangan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="430" y="285" width="310" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="hw7" value="&lt;b&gt;Indikator LED Sesuai SPLN Butir 6.9&lt;/b&gt;&lt;br/&gt;Pin: PE12 (Merah 1: Imp/kWh), PE13 (Merah 2: Imp/kVARh), PB7 (Kuning: LED_ALM Alarm)&lt;br/&gt;Fungsi: Indikasi Pulsa Kalibrasi &amp;amp; Peringatan Visual (Buzzer Ditiadakan per LOG-060)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="385" width="640" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="hw_card" value="&lt;b&gt;INTEGRITAS PERANGKAT KERAS:&lt;/b&gt;&lt;br/&gt;Seluruh alokasi pin telah diverifikasi bebas dari konflik pin GPIO (100% compliant dengan PIN.docx). Pin PB7 didedikasikan murni untuk LED Kuning Alarm sesuai standar PLN tanpa aktuator audio." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#14532d;" vertex="1" parent="1">
          <mxGeometry x="100" y="475" width="640" height="55" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
