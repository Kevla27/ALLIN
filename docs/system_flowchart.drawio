  <diagram id="Tab1_Macro_Overview" name="1. Ikhtisar Sistem Makro">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="840" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="m_hdr" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;ARSITEKTUR TINGKAT TINGGI FIRMWARE SMART METER 3-FASA (ALLIN)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;Ikhtisar 6 Grup Fungsional Utama (Target: STM32U585 ARM Cortex-M33 TrustZone)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="g_boot" value="&lt;b&gt;GRUP 1: BOOTSTRAPPING &amp;amp; KEAMANAN TRUSTZONE&lt;/b&gt;&lt;br/&gt;Power-On Reset, NSC Gateway, RTC LSE, Inisialisasi HAL Periferal &amp;amp; Start FreeRTOS Kernel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#6366f1;fontColor=#1e1b4b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="160" y="95" width="520" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="g_rtos" value="&lt;b&gt;GRUP 2: SIKLUS UTAMA FREERTOS (PERIODIK 100 ms)&lt;/b&gt;&lt;br/&gt;app_metering_task_loop() mengorkestrasi eksekusi sekuensial bebas-blocking tiga pilar" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="160" y="180" width="520" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="g_e1" value="&lt;b&gt;GRUP 3: PILAR E1 - METROLOGI ADE9000&lt;/b&gt;&lt;br/&gt;Akuisisi ADC SPI1, Kalkulasi Daya P/Q/S, Akumulasi Wh/varh 4-Kuadran &amp;amp; Update s_meas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#10b981;fontColor=#064e3b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="160" y="260" width="520" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="g_e2" value="&lt;b&gt;GRUP 4: PILAR E2 - PROTOKOL DLMS/COSEM&lt;/b&gt;&lt;br/&gt;Sinkronisasi Snapshot Register OBIS, Profil Beban 15-Menit &amp;amp; Security Suite 0 (AES-128-GCM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0284c7;fontColor=#082f49;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="160" y="345" width="520" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="g_e3" value="&lt;b&gt;GRUP 5: PILAR E3 - APLIKASI SMART METER &amp;amp; HMI&lt;/b&gt;&lt;br/&gt;Evaluasi Tarif ToU, Proteksi Relai FSM, Display OLED SSD1306 &amp;amp; Penyimpanan Flash NVRAM&lt;br/&gt;&lt;i&gt;(Rincian logika dijabarkan mandiri pada 4 Diagram Khusus E3)&lt;/i&gt;" style="shape=process;backgroundOutline=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="160" y="430" width="520" height="65" as="geometry"/>
        </mxCell>
        <mxCell id="g_delay" value="&lt;b&gt;Tunda Siklus 100 ms (osDelay)&lt;/b&gt;&lt;br/&gt;Menyerahkan Waktu CPU ke Tickless Low-Power Idle" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=#334155;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="525" width="240" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="g_isr" value="&lt;b&gt;GRUP 6: JALUR ASINKRON &amp;amp; INTERRUPT SERVICE ROUTINE (ISR)&lt;/b&gt;&lt;br/&gt;Interupsi UART RX (Parser HDLC/APDU Port Optik &amp;amp; Modem) serta EXTI GPIO (Last-Gasp AC Padam &amp;amp; Tombol)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#f43f5e;fontColor=#881337;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="160" y="615" width="520" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="g_hw" value="&lt;b&gt;GRUP 7: LAPISAN PERANGKAT KERAS &amp;amp; MEDIA PENYIMPANAN EKSTERNAL&lt;/b&gt;&lt;br/&gt;AFE ADE9000, Flash NVRAM SPI2, OLED I2C3, Relai Kontaktor Shunt Trip, Port Serial USART &amp;amp; Sensor Sabotase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="160" y="710" width="520" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="g_nav" value="&lt;b&gt;PANDUAN NAVIGASI TAB MODULAR:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Tab 2:&lt;/b&gt; Rincian Bootstrapping &amp;amp; TrustZone  |  • &lt;b&gt;Tab 3:&lt;/b&gt; Rincian Pilar E1 Metrologi ADE9000&lt;br/&gt;• &lt;b&gt;Tab 4:&lt;/b&gt; Rincian Pilar E2 DLMS/COSEM          |  • &lt;b&gt;Tab 5:&lt;/b&gt; Rincian Pilar E3 Aplikasi &amp;amp; HMI&lt;br/&gt;• &lt;b&gt;Tab 6:&lt;/b&gt; Rincian Jalur Asinkron ISR &amp;amp; Daya     |  • &lt;b&gt;Tab 7:&lt;/b&gt; Peta Hardware &amp;amp; Alokasi Pin MCU" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;fillColor=#f5f3ff;strokeColor=#8b5cf6;fontColor=#4c1d95;" vertex="1" parent="1">
          <mxGeometry x="160" y="805" width="520" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e_m_boot_rtos" value="Scheduler Start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;fontColor=#1e293b;fontSize=11;" edge="1" parent="1" source="g_boot" target="g_rtos">
