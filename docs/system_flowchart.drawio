          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="b_card" value="&lt;b&gt;PETA MEMORI ARSITEKTUR TRUSTZONE:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Secure Flash (0x0C000000):&lt;/b&gt; Bootloader, NSC Gateway, RTC Driver, Kunci AES.&lt;br/&gt;• &lt;b&gt;Non-Secure Flash (0x08040000):&lt;/b&gt; FreeRTOS v11, Bridge, Pilar E1, E2, E3.&lt;br/&gt;• &lt;b&gt;Non-Secure SRAM (0x20000000):&lt;/b&gt; RTOS Heap, Stacks, Snapshot &amp;amp; FIFO Queue.&lt;br/&gt;• &lt;b&gt;Domain VBAT:&lt;/b&gt; BKP Register Retensi Abad &amp;amp; Status Baterai Rendah." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;fillColor=#ede9fe;strokeColor=#8b5cf6;fontColor=#4c1d95;" vertex="1" parent="1">
          <mxGeometry x="200" y="745" width="420" height="85" as="geometry"/>
