        </mxCell>
        <mxCell id="x_start" value="&lt;b&gt;HAL_GPIO_EXTI_Callback(GPIO_Pin)&lt;/b&gt;&lt;br/&gt;Interupsi Asinkron Sinyal Fisik GPIO" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#f43f5e;fontColor=#881337;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="85" width="340" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="x_q_src" value="&lt;b&gt;Identifikasi Sumber Pin EXTI?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#eab308;fontColor=#713f12;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
