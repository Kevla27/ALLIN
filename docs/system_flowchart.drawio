        </mxCell>
        <mxCell id="x_btn" value="&lt;b&gt;Tombol Navigasi Layar (UP / DN)&lt;/b&gt;&lt;br/&gt;Navigasi Layar Manual atau Tekan Simultan (▲ + ▼) Selama 1 Detik untuk Konfirmasi Rekoneksi Relai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#1e293b;fontSize=11;align=center;" vertex="1" parent="1">
