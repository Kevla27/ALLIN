        <mxCell id="b_hdr" value="&lt;b&gt;PROSEDUR BOOTSTRAPPING &amp;amp; KEAMANAN TRUSTZONE&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Inisialisasi Cold Boot, Gateway Keamanan Cortex-M33, Periferal Hardware &amp;amp; Kernel FreeRTOS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=11.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="130" y="20" width="700" height="38" as="geometry" />
        </mxCell>

        
        <mxCell id="b1" value="&lt;b&gt;START: POWER-ON RESET (POR)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Catu Daya 3.3V Aktif &amp;amp; Reset Sistem Selesai&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="320" y="74" width="320" height="34" as="geometry" />
        </mxCell>

        
        <mxCell id="b2" value="&lt;b&gt;INISIALISASI KEAMANAN TRUSTZONE (CORTEX-M33)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Konfigurasi Gateway NSC, Driver RTC LSE 32.768 kHz &amp;amp; Sensor Tamper Fisik&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="124" width="560" height="42" as="geometry" />
        </mxCell>

        
        <mxCell id="b3" value="&lt;b&gt;INISIALISASI HAL HARDWARE &amp;amp; PERIFERAL&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Clock Sistem 160 MHz, SPI1 ADE9000, SPI2 Flash, I2C3 OLED, USART &amp;amp; ADC4&lt;/font&gt;" style="shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="182" width="560" height="42" as="geometry" />
        </mxCell>

        
        <mxCell id="b4" value="&lt;b&gt;INISIALISASI LAYANAN INTI SISTEM (meter_system_bringup)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Aktivasi Layanan Metrologi Listrik, Protokol Komunikasi DLMS &amp;amp; Aplikasi Smart Meter&lt;/font&gt;" style="shape=process;backgroundOutline=1;rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="240" width="560" height="42" as="geometry" />
        </mxCell>

        
        <mxCell id="b5" value="&lt;b&gt;PEMULIHAN PARAMETER DARI FLASH NVRAM (SPI2)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Muat Checkpoint Energi Wh/varh, Parameter Tarif ToU &amp;amp; Pointer Logbook FIFO&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="298" width="560" height="42" as="geometry" />
        </mxCell>

        
        <mxCell id="b6" value="&lt;b&gt;CETAK BANNER SERIAL &amp;amp; TAMPILAN SPLASH OLED&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Kirim Log Booting ke USART2 (19200 bps) &amp;amp; Tampilkan Layar Selamat Datang SPLN&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="356" width="560" height="42" as="geometry" />
        </mxCell>

        
        <mxCell id="b7" value="&lt;b&gt;ALOKASI KERNEL FREERTOS &amp;amp; DEFAULT TASK&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Inisialisasi Kernel, Alokasi Task Utama (Stack 4KB, Prioritas Normal) &amp;amp; Tickless Idle&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="414" width="560" height="42" as="geometry" />
        </mxCell>

        
        <mxCell id="b8" value="&lt;b&gt;JALANKAN SCHEDULER RTOS (osKernelStart)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Scheduler Aktif &amp;amp; Mengambil Alih Manajemen Eksekusi Thread CPU&lt;/font&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="472" width="560" height="38" as="geometry" />
        </mxCell>

        
        <mxCell id="b9" value="&lt;b&gt;MENUJU TAB 1: SIKLUS UTAMA PERIODIK (100 ms)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Eksekusi Loop Rutin Utama Sistem: app_metering_task_loop()&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontStyle=1;fontSize=10.5;align=center;" vertex="1" parent="1">
          <mxGeometry x="290" y="526" width="380" height="36" as="geometry" />
        </mxCell>

        
        <mxCell id="b_card" value="&lt;b&gt;PETA ALOKASI MEMORI SISTEM (TRUSTZONE CORTEX-M33):&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Secure Flash (0x0C000000):&lt;/b&gt; Bootloader, Gateway NSC, Driver RTC, Kunci Enkripsi AES.&lt;br/&gt;• &lt;b&gt;Non-Secure Flash (0x08040000):&lt;/b&gt; Kernel FreeRTOS, Bridge, Modul Metrologi, DLMS &amp;amp; Aplikasi.&lt;br/&gt;• &lt;b&gt;Non-Secure SRAM (0x20000000):&lt;/b&gt; Heap RTOS, Task Stacks, Snapshot Pengukuran &amp;amp; Antrean FIFO.&lt;br/&gt;• &lt;b&gt;Domain Baterai VBAT:&lt;/b&gt; Register Retensi BKP (RTC Kalender Abad) &amp;amp; Pemantau Tegangan Baterai." style="rounded=1;whiteSpace=wrap;html=1;fontSize=9.5;align=left;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="130" y="578" width="700" height="68" as="geometry" />
        </mxCell>

        
