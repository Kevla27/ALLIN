  <diagram id="Tab5_Asynchronous_ISR" name="5. Jalur Asinkron &amp; ISR">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1020" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="isr_hdr" value="&lt;b&gt;BAGAN ALIR RINCI: JALUR ASINKRON &amp;amp; INTERRUPT SERVICE ROUTINE (ISR)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:10px;&quot;&gt;Penanganan Paket Serial UART DLMS serta Kejadian Eksternal GPIO EXTI Hardware&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=12;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="940" height="38" as="geometry" />
        </mxCell>
        <mxCell id="u_title" value="&lt;b&gt;JALUR INTERRUPSI SERIAL UART (PORT OPTIK &amp;amp; MODEM)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=11;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="430" height="28" as="geometry" />
        </mxCell>
        <mxCell id="u_start" value="&lt;b&gt;HAL_UART_RxCpltCallback(huart)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Interupsi Penerimaan Karakter Serial USART2 / USART3&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=10.5;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="80" y="110" width="350" height="44" as="geometry" />
        </mxCell>
        <mxCell id="u_q_cli" value="&lt;b&gt;Karakter ASCII CLI?&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;(Non-HDLC Flag 0x7E)&lt;/font&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="145" y="172" width="220" height="48" as="geometry" />
        </mxCell>
        <mxCell id="u_cli_pop" value="&lt;b&gt;KIRIM KE KONSOL INTERAKTIF&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Push Byte ke Antrean FIFO CLI USART2&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="40" y="242" width="190" height="46" as="geometry" />
        </mxCell>
        <mxCell id="u_push" value="&lt;b&gt;PUSH KE RING BUFFER DEKODER&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Antrean Buffer Penerimaan Frame HDLC&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="250" y="242" width="220" height="46" as="geometry" />
        </mxCell>
        <mxCell id="u_q_hdlc" value="&lt;b&gt;Frame Lengkap &amp;amp; FCS-16 Valid?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="250" y="312" width="220" height="48" as="geometry" />
        </mxCell>
        <mxCell id="u_parse" value="&lt;b&gt;DEKODER LAYER APLIKASI APDU DLMS&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Otentikasi Security Suite 0, Dekripsi AES-128-GCM &amp;amp; Validasi NVM Counter&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="70" y="384" width="400" height="44" as="geometry" />
        </mxCell>
        <mxCell id="u_exec" value="&lt;b&gt;EKSEKUSI PERINTAH APDU DLMS&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Proses AARQ, GET (Normal / DataBlock), SET atau ACTION Class 70 Relai&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="70" y="448" width="400" height="44" as="geometry" />
        </mxCell>
        <mxCell id="u_tx" value="&lt;b&gt;TRANSMISI RESPONS FRAME HDLC&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Kirim Paket Balasan ke Port Optik / Modem via UART TX&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10.5;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
