  <diagram id="Tab5_E3_App_Hub" name="5. Pilar E3 Aplikasi &amp; HMI">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="840" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="e3_hdr" value="&lt;b&gt;FLOWCHART RINCI: PILAR E3 - APLIKASI SMART METER &amp;amp; HMI&lt;/b&gt;&lt;br/&gt;Hub Orkestrasi 4 Sub-Proses Spesifik (Rincian Decision Tree ada di FlowChartE3.drawio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e3_start" value="&lt;b&gt;e3_meter_app_step(&amp;amp;s_meas, delta_ms)&lt;/b&gt;&lt;br/&gt;Pemicu Eksekusi Aplikasi Master dari FreeRTOS Task (100 ms)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="230" y="85" width="380" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e3_m1" value="&lt;b&gt;[Sub-Proses 1] Siklus Utama Orkestrasi E3&lt;/b&gt;&lt;br/&gt;Snapshot Metrologi, Evaluasi Tarif ToU (WBP/LWBP), Telemetri ADC4 &amp;amp; Rekam Profil Beban" style="shape=process;backgroundOutline=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="180" y="155" width="480" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e3_m2" value="&lt;b&gt;[Sub-Proses 2] Logika Proteksi Relai &amp;amp; Sabotase FSM&lt;/b&gt;&lt;br/&gt;Filter 9 Vektor Tamper, Batas Tegangan/Beban, Trip Koil Shunt &amp;amp; Indikator LED Kuning PB7" style="shape=process;backgroundOutline=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="180" y="240" width="480" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e3_m3" value="&lt;b&gt;[Sub-Proses 3] Mesin Tampilan HMI &amp;amp; Carousel Layar&lt;/b&gt;&lt;br/&gt;Render Layar Matriks OLED SSD1306, Rotasi Halaman Otomatis/Manual &amp;amp; Navigasi Tombol" style="shape=process;backgroundOutline=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="180" y="325" width="480" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e3_m4" value="&lt;b&gt;[Sub-Proses 4] Manajemen Listrik Padam &amp;amp; Stop 2&lt;/b&gt;&lt;br/&gt;Prosedur Darurat Last-Gasp, Off-Power Standby 10 Detik &amp;amp; Transisi Mode Hemat Daya Stop 2" style="shape=process;backgroundOutline=1;rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#78350f;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="180" y="410" width="480" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e3_dly" value="&lt;b&gt;Tunda Siklus 100 ms (osDelay)&lt;/b&gt;&lt;br/&gt;FreeRTOS Menyerahkan Waktu CPU ke Tickless Low-Power Idle" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=#334155;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="270" y="495" width="300" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e3_hub_card" value="&lt;b&gt;RELASI DEKOMPOSISI KE FILE FLOWCHARTE3.DRAWIO:&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Tab 1 (Siklus Utama):&lt;/b&gt; Rincian snapshot, kalkulasi tarif ToU &amp;amp; penulisan record NVRAM.&lt;br/&gt;• &lt;b&gt;Tab 2 (Sabotase &amp;amp; Relai):&lt;/b&gt; State machine relai, decision tree trip, lockout &amp;amp; rekoneksi tombol.&lt;br/&gt;• &lt;b&gt;Tab 3 (Tampilan HMI):&lt;/b&gt; Rotasi halaman carousel, prioritas error alarm &amp;amp; transfer I2C3 OLED.&lt;br/&gt;• &lt;b&gt;Tab 4 (Listrik Padam):&lt;/b&gt; Interupsi AC_FAIL_DET, standby 10 detik &amp;amp; deep sleep Stop 2 (4.5 uA)." style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;align=left;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#78350f;" vertex="1" parent="1">
          <mxGeometry x="180" y="565" width="480" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="e3_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;fontColor=#1e293b;fontSize=11;" edge="1" parent="1" source="e3_start" target="e3_m1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;fontColor=#1e293b;fontSize=11;" edge="1" parent="1" source="e3_m1" target="e3_m2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;fontColor=#1e293b;fontSize=11;" edge="1" parent="1" source="e3_m2" target="e3_m3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;fontColor=#1e293b;fontSize=11;" edge="1" parent="1" source="e3_m3" target="e3_m4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#475569;strokeWidth=2;endArrow=classic;endFill=1;labelBackgroundColor=#ffffff;fontColor=#1e293b;fontSize=11;" edge="1" parent="1" source="e3_m4" target="e3_dly">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
