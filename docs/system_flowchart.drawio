        <mxCell id="x_start" value="&lt;b&gt;HAL_GPIO_EXTI_Callback(GPIO_Pin)&lt;/b&gt;&lt;br/&gt;Interupsi Asinkron Sinyal Fisik GPIO (Falling / Rising)" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffe4e6;strokeColor=#f43f5e;fontColor=#881337;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
