        </mxCell>
        <mxCell id="x_q_src" value="&lt;b&gt;Identifikasi Sumber Pin EXTI?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#eab308;fontColor=#713f12;fontStyle=1;fontSize=10.5;align=center;" vertex="1" parent="1">
