  <diagram id="Tab3_E1_Metrology" name="3. Pilar E1 Metrologi">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="820" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="e1_hdr" value="&lt;b&gt;FLOWCHART RINCI: PILAR E1 - METROLOGI ADE9000&lt;/b&gt;&lt;br/&gt;Akuisisi ADC, Perhitungan Daya &amp;amp; Akumulasi Energi Listrik Presisi (IEC 62053)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;fontColor=#ffffff;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="740" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e1_start" value="&lt;b&gt;e1_metrology_service_step(&amp;amp;s_meas, delta_ms)&lt;/b&gt;&lt;br/&gt;Titik Eksekusi Periodik Metrologi dari FreeRTOS Task" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="220" y="85" width="380" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e1_read" value="&lt;b&gt;Baca Register ADC ADE9000 via SPI1 Bus&lt;/b&gt;&lt;br/&gt;Ambil VRMS Fasa (UR, US, UT), IRMS Fasa &amp;amp; Netral serta Sudut Fasa" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#10b981;fontColor=#064e3b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="220" y="155" width="380" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e1_q_syn" value="&lt;b&gt;Mode Beban Sintetis Aktif?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef9c3;strokeColor=#eab308;fontColor=#713f12;fontStyle=1;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="310" y="225" width="200" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="e1_act_syn" value="&lt;b&gt;Gunakan Nilai Sintetis CLI&lt;/b&gt;&lt;br/&gt;Injeksi parameter simulasi pengujian" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#10b981;fontColor=#064e3b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="227.5" width="200" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e1_act_real" value="&lt;b&gt;Gunakan Nilai Riil ADC ADE9000&lt;/b&gt;&lt;br/&gt;Konversi register mentah ke besaran listrik fisik" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#10b981;fontColor=#064e3b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="540" y="227.5" width="210" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="e1_calc" value="&lt;b&gt;Hitung Daya &amp;amp; Akumulasi Energi Presisi&lt;/b&gt;&lt;br/&gt;Kalkulasi Daya P/Q/S, PF, Frekuensi Hz &amp;amp; Akumulasi Wh Impor/Ekspor serta varh 4-Kuadran" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#10b981;fontColor=#064e3b;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="200" y="310" width="420" height="55" as="geometry"/>
