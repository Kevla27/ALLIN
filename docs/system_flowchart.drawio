        <mxCell id="x_start" value="&lt;b&gt;HAL_GPIO_EXTI_Callback(GPIO_Pin)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Interupsi Asinkron Sinyal Fisik GPIO (Falling / Rising)&lt;/font&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=10.5;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="550" y="110" width="390" height="44" as="geometry" />
        </mxCell>
        <mxCell id="x_q_src" value="&lt;b&gt;Identifikasi Sumber Pin EXTI?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="635" y="172" width="220" height="48" as="geometry" />
        </mxCell>
        <mxCell id="x_acfail" value="&lt;b&gt;AC_FAIL_DET (PC3 - Listrik Padam / Pulih)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;• Falling: Last-Gasp Notifikasi DLMS, Simpan Checkpoint ke Flash &amp;amp; Masuk Stop 2&lt;br/&gt;• Rising: Pulihkan Sistem, Re-arm ADE9000 &amp;amp; Nyalakan OLED&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="540" y="242" width="410" height="52" as="geometry" />
        </mxCell>
        <mxCell id="x_btn" value="&lt;b&gt;Tombol Navigasi Layar (PA0 UP / PB6 DN)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;• Satu Tombol: Navigasi Layar Manual / Bangunkan OLED Off-Power (10s)&lt;br/&gt;• Tekan Simultan (▲ + ▼) 1 Detik: Konfirmasi Rekoneksi Relai Manual&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="540" y="308" width="410" height="52" as="geometry" />
        </mxCell>
        <mxCell id="x_ade" value="&lt;b&gt;ADE_IRQ / DREADY / CF (Data Ready &amp;amp; Pulsa)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;• PB5 IRQ0: Reverse Power | PB1 IRQ1: Netral Bypass | PE11: DREADY ADC&lt;br/&gt;• PE12 CF1: Pulsa Wh Aktif | PE13 CF2: Pulsa varh Reaktif | PE8: Zero Crossing&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="540" y="374" width="410" height="52" as="geometry" />
        </mxCell>
        <mxCell id="x_aux" value="&lt;b&gt;AUX_CTRL_IN1 (PC10) &amp;amp; IN2 (PC14)&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:9.5px;&quot;&gt;Input Sinyal Bantu Eksternal &amp;amp; Pencatatan Logbook Status I/O&lt;/font&gt;" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=10;align=left;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="540" y="440" width="410" height="44" as="geometry" />
        </mxCell>
        <mxCell id="x_end" value="&lt;b&gt;SELESAI PENANGANAN EVENT ISR GPIO&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontSize=10.5;align=center;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="605" y="504" width="280" height="38" as="geometry" />
        </mxCell>
        <mxCell id="x_card" value="&lt;b&gt;MANAJEMEN OFF-POWER STANDBY (10 DETIK):&lt;/b&gt;&lt;br/&gt;Saat listrik jala-jala padam, menekan tombol navigasi akan menyalakan layar OLED selama 10 detik dari cadangan superkapasitor (PC2 VCAP) agar pembacaan stand energi dapat dilakukan sesuai SPLN D3.006:2021." style="whiteSpace=wrap;html=1;fontSize=9.5;align=left;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1;fontColor=#000000;spacingLeft=10;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="510" y="560" width="470" height="56" as="geometry" />
        </mxCell>
